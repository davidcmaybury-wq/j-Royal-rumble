# Copy this to .env and fill in what you need — `.env` is gitignored, `.env.example`
# is not, so this is the reference and never a place a real key can end up. Node
# reads it itself: `npm start` and `npm run dev` both run with `--env-file=.env`,
# and Node refuses to start at all if that file does not exist — so the first
# step really is `cp .env.example .env`, even if you leave every line blank.
#
# Nothing here is required to run a match. Leave it all empty and you get:
# admin/log routes locked (by design — see CLAUDE.md, "the guards fail closed"),
# robots' wrong answers from local nonsense instead of a model, and an autohost
# match that refuses to start until either ANTHROPIC_API_KEY or RUMBLE_JUDGE=local
# is set. Everything else about the game plays exactly the same.
#
# The full picture, including what each one costs when it is missing, is
# infra/aws/HOSTING.md under "Secrets and environment" — this file is the names,
# that one is the reasoning.

# --- the two guards ----------------------------------------------------------
# Fail closed with no value: /control and /api/logs refuse everyone, including
# you, and the server says so at boot rather than staying quiet about it.
RUMBLE_ADMIN_KEY=
RUMBLE_LOG_KEY=

# --- the judge and the robots' wrong answers ---------------------------------
# One key, two jobs: it rules on spoken answers in an autohost match and writes
# a robot's wrong answer instead of local nonsense. Get one in its own
# Anthropic Console workspace with a spend limit — not a key shared with
# anything else — the same way the box's own key is meant to be.
ANTHROPIC_API_KEY=
# Set to "local" to run the computer host with no key at all: a deliberate,
# weaker mode that rules on word overlap and never says "wrong", so a failed
# call cannot cost anybody a clue. Leave blank to require the real key above.
RUMBLE_JUDGE=

# --- the voice ----------------------------------------------------------------
# Which engine speaks: silent (default — the host reads from the clock, no
# audio, and how CI runs), piper, edge, kokoro, or elevenlabs. Piper needs a
# binary and a voice directory; see infra/aws/HOSTING.md, "The voice (autohost),
# installed outside npm" for the local install recipe.
RUMBLE_TTS=
PIPER_BIN=
PIPER_DATA_DIR=

# --- the availability mapper (/when) ------------------------------------------
# All optional; unset means /when still serves but sign-in and posting refuse,
# naming whichever of these is missing. docs/discord-setup.md is the five-minute
# version of getting the first six.
RUMBLE_DISCORD_CLIENT_ID=
RUMBLE_DISCORD_CLIENT_SECRET=
RUMBLE_DISCORD_BOT_TOKEN=
RUMBLE_DISCORD_ALERT_CHANNEL=
RUMBLE_DISCORD_ROOM_CHANNEL=
RUMBLE_DISCORD_GUILD=
RUMBLE_PUBLIC_URL=
RUMBLE_SESSION_SECRET=
